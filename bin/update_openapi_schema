#!/usr/bin/env bash

source "$(dirname "${BASH_SOURCE[0]}")/_config.sh"

_dc_run \
    -e DJANGO_CONFIGURATION=Test \
    app \
    sh -c "mkdir -p /app/core/tests/swagger && python manage.py export_openapi_schema \
    --api core.api.api \
    --indent 2 \
    --output /app/core/tests/swagger/swagger.json"
