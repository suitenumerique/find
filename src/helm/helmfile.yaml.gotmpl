environments:
  dev:
    values:
      - version: 0.0.4
---
repositories:
  - name: dev-backend
    url: https://suitenumerique.github.io/helm-dev-backend
  - name: opensearch
    url: https://opensearch-project.github.io/helm-charts

releases:
  - name: dev-backend
    namespace: {{ .Namespace }}
    chart: dev-backend/dev-backend
    version: 0.0.17
    values:
      - env.d/{{ .Environment.Name }}/values.dev-backend.yaml.gotmpl

  - name: opensearch
    namespace: {{ .Namespace }}
    chart: opensearch/opensearch
    version: 3.9.0
    values:
      - env.d/{{ .Environment.Name }}/values.opensearch.yaml.gotmpl

  - name: opensearch-dashboards
    namespace: {{ .Namespace }}
    chart: opensearch/opensearch-dashboards
    version: 3.9.0
    values:
      - env.d/{{ .Environment.Name }}/values.opensearch-dashboards.yaml.gotmpl

  - name: find
    version: {{ .Values.version }}
    namespace: {{ .Namespace }}
    chart: ./find
    values:
      - env.d/{{ .Environment.Name }}/values.find.yaml.gotmpl
